DATABASE_URL="postgresql://lunchmatch:lunchmatch_dev@localhost:5432/lunchmatch"
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"

# Only needed when the app runs behind a reverse proxy (the Pi deployment sets
# both in the Portainer stack, not here). AUTH_URL is the public origin;
# AUTH_TRUST_HOST tells NextAuth v5 to trust the forwarded Host header, without
# which sign-in callbacks fail behind SWAG.
# AUTH_URL="https://lunchmatch.nikolasreuber.de"
# AUTH_TRUST_HOST="true"

# Set to "production" on deployed instances. `npm run db:seed` refuses to run
# when it sees this, because seeding wipes every user, match request and
# message. The Docker image sets it already.
# APP_ENV="production"
